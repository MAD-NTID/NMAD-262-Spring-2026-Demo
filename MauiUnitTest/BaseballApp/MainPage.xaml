<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BaseballApp.MainPage">

    <StackLayout Padding="10" Spacing="10">
        <!-- Header Label -->
        <Label Text="Welcome to the Baseball App!"
               VerticalOptions="Center"
               HorizontalOptions="Center" 
               FontSize="24"
               Margin="0,0,0,20"/>
        
        <Button Text="Add a new player" Clicked="AddNewPlayer" HorizontalOptions="Center"/>

        <!-- CollectionView -->
        <CollectionView
            ItemsSource="{Binding Players}"
            SelectedItem="{Binding SelectedPlayer}"
            SelectionMode="Single">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Horizontal row layout -->
                    <StackLayout Orientation="Horizontal" Padding="10" Spacing="10">
                        <!-- Player Image -->
                        <Image Source="{Binding ImageUrl}" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"/>

                        <!-- Text stack -->
                        <StackLayout Orientation="Vertical" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold"/>
                            <Label Text="{Binding Team}" FontSize="16"/>
                        </StackLayout>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>

</ContentPage>