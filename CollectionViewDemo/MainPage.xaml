<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converter="clr-namespace:CollectionViewDemo"
             x:Class="CollectionViewDemo.MainPage">

             <VerticalStackLayout>
                <Button Text="Take Photo" Clicked="TakePhoto"  HorizontalOptions="Fill" Margin="10" WidthRequest="100"/>
                <Button Text="Add Car" Clicked="AddNewCarPage"  HorizontalOptions="Fill" Margin="10" WidthRequest="100"/>
                <!--YOU MUST HAVE SelectionMode="Single" to use SelectedItem!-->
                <CollectionView
                    ItemsSource="{Binding Cars}"
                    SelectedItem="{Binding SelectCar}"
                    SelectionMode="Single" 
                    >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Orientation="Horizontal" Padding="10">
                                <Image Source="{Binding ImageUrl}" WidthRequest="100" HeightRequest="60" Aspect="AspectFill"/>
                                <StackLayout Orientation="Vertical" Margin="10,0">
                                    <Label Text="{Binding Make}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Model}"/>
                                    <Label Text="{Binding Year}"/>
                                    <Label Text="{Binding IsNew, Converter={converter:CarStatusConverter}}"/>
                                </StackLayout>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
             </VerticalStackLayout>



  
